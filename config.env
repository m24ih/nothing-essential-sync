# ==============================================================================
# Nothing Essential Space -> Obsidian Sync Configuration
# ==============================================================================

# Target Obsidian / Markdown notes directory (where notes will be created)
DEST_NOTES="/storage/emulated/0/Sync/Obsidian-Vaults/Personal-Obsidian/00-Zettelkasten"

# Target attachments directory (where images and voice recordings will be copied)
DEST_ATTACHMENTS="/storage/emulated/0/Sync/Obsidian-Vaults/Personal-Obsidian/99-index/Files"

# Filename timestamp format (SQLite strftime format)
# Examples: "%Y-%m-%d %H.%M" (e.g. 2026-10-06 12.30)
#           "%Y-%m-%d-%H%M"  (e.g. 2026-10-06-1230)
TIME_FORMAT="%Y-%m-%d %H.%M"

# Default tag added to Markdown frontmatter
NOTE_TAG="inbox/essential-space"
